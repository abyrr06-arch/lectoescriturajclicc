  <activity class="@associations.ComplexAssociation" name="ASOCIACIÓN DE LETRAS A IMÁGENES" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Bell MT" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0xCCCCCC" />
     </style>
     <p>Bienvenidos! Asocia letras con imágenes</p>
