   </settings>
   <textGrid rows="12" columns="12" cellWidth="23.0" cellHeight="20.0" border="true">
    <style>
     <color background="0xFFFFFF" />
    </style>
    <text>
     <row>ALUNDGEOLSAV</row>
     <row>DCASASNOLGJM</row>
     <row>QLACOLASDOKA</row>
     <row>MIAVANUESSAF</row>
     <row>TWICEFRNANAA</row>
     <row>CAPMIOLAATOH</row>
     <row>SAPSNARIZJAJ</row>
     <row>APELOTAMNAKK</row>
     <row>LORGATOSAJEN</row>
     <row>ASRJAJCAMALO</row>
     <row>MOOCOMOCREES</row>
     <row>NOOMESASIINO</row>
    </text>
   </textGrid>
   <clues>
