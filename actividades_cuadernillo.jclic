    <cell type="final">
     <style>
      <font family="Bell MT" size="48" bold="true" />
      <color foreground="0xFFFFFF" background="0xCCCCCC" />
     </style>
     <p>Muy bien hecho!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0x9999FF">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" border="true" />
